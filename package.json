{
    "name":  "visual-trading-browser",
    "version":  "0.1.0",
    "description":  "Prediction-only visual browser for market candle analysis.",
    "main":  "dist-electron/main.js",
    "private":  true,
    "scripts":  {
                    "dev":  "npm run build:electron \u0026\u0026 electron .",
                    "build:electron":  "tsc -p tsconfig.node.json",
                    "start":  "npm run build:electron \u0026\u0026 electron .",
                    "analyzer:setup":  "powershell -ExecutionPolicy Bypass -File scripts/setup-analyzer.ps1",
                    "analyzer:dev":  "powershell -ExecutionPolicy Bypass -File scripts/run-analyzer.ps1",
                    "analyzer:health":  "powershell -ExecutionPolicy Bypass -File scripts/test-analyzer-health.ps1",
                    "analyzer:smoke":  ".venv\\\\Scripts\\\\python.exe -m analyzer.tools.smoke_test"
                },
    "dependencies":  {
                         "react":  "^19.0.0",
                         "react-dom":  "^19.0.0",
                         "sharp":  "^0.35.3",
                         "tesseract.js":  "^6.0.1"
                     },
    "devDependencies":  {
                            "@types/node":  "^22.0.0",
                            "@types/react":  "^19.0.0",
                            "@types/react-dom":  "^19.0.0",
                            "@vitejs/plugin-react":  "^4.7.0",
                            "concurrently":  "^9.0.0",
                            "cross-env":  "^7.0.0",
                            "electron":  "^37.0.0",
                            "typescript":  "^5.0.0",
                            "vite":  "^6.3.5",
                            "wait-on":  "^8.0.0"
                        }
}
